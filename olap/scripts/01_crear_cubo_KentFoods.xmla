          <Hierarchies><Hierarchy><ID>Geografia</ID><Name>Geografía</Name><Levels><Level><ID>Pais</ID><Name>País</Name><SourceAttributeID>Pais</SourceAttributeID></Level><Level><ID>Ciudad</ID><Name>Ciudad</Name><SourceAttributeID>Ciudad</SourceAttributeID></Level><Level><ID>Cliente Key</ID><Name>Cliente</Name><SourceAttributeID>Cliente Key</SourceAttributeID></Level></Levels></Hierarchy></Hierarchies>
