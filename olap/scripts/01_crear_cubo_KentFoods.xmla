<!--
  Kent Foods - Fase 2: base OLAP multidimensional KentFoods_OLAP
  Ejecutar en SSMS conectado a ANALYSIS SERVICES (no al motor de base de datos):
  File > Open > este archivo, y luego Execute (F5).
  Crea (o reemplaza) la base con: origen de datos, vista de datos, 5 dimensiones,
  el cubo KentFoods con 2 grupos de medidas, cálculos MDX y 4 KPI.
  Después ejecutar 02_procesar_cubo.xmla para cargar los datos.
-->
<Create AllowOverwrite="true" xmlns="http://schemas.microsoft.com/analysisservices/2003/engine">
  <ObjectDefinition>
    <Database xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <ID>KentFoods_OLAP</ID>
      <Name>KentFoods_OLAP</Name>
      <DataSourceImpersonationInfo><ImpersonationMode>Default</ImpersonationMode></DataSourceImpersonationInfo>
      <Dimensions>
        <Dimension>
          <ID>Dim Tiempo</ID>
          <Name>Tiempo</Name>
          <Source xsi:type="DataSourceViewBinding"><DataSourceViewID>KentFoodsDW</DataSourceViewID></Source>
          <Attributes><Attribute><ID>Tiempo Key</ID><Name>Fecha</Name><Usage>Key</Usage><KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>dbo_vDimTiempo</TableID><ColumnID>TiempoKey</ColumnID></Source></KeyColumn></KeyColumns><NameColumn><DataType>WChar</DataType><DataSize>20</DataSize><Source xsi:type="ColumnBinding"><TableID>dbo_vDimTiempo</TableID><ColumnID>FechaNombre</ColumnID></Source></NameColumn><AttributeRelationships><AttributeRelationship><AttributeID>Mes</AttributeID><Name>Mes</Name></AttributeRelationship><AttributeRelationship><AttributeID>Dia Semana</AttributeID><Name>Dia Semana</Name></AttributeRelationship></AttributeRelationships><OrderBy>Key</OrderBy></Attribute><Attribute><ID>Mes</ID><Name>Mes</Name><KeyColumns><KeyColumn><DataType>SmallInt</DataType><Source xsi:type="ColumnBinding"><TableID>dbo_vDimTiempo</TableID><ColumnID>Anio</ColumnID></Source></KeyColumn><KeyColumn><DataType>UnsignedTinyInt</DataType><Source xsi:type="ColumnBinding"><TableID>dbo_vDimTiempo</TableID><ColumnID>Mes</ColumnID></Source></KeyColumn></KeyColumns><NameColumn><DataType>WChar</DataType><DataSize>30</DataSize><Source xsi:type="ColumnBinding"><TableID>dbo_vDimTiempo</TableID><ColumnID>MesNombre</ColumnID></Source></NameColumn><AttributeRelationships><AttributeRelationship><AttributeID>Trimestre</AttributeID><Name>Trimestre</Name></AttributeRelationship></AttributeRelationships><OrderBy>Key</OrderBy></Attribute><Attribute><ID>Trimestre</ID><Name>Trimestre</Name><KeyColumns><KeyColumn><DataType>SmallInt</DataType><Source xsi:type="ColumnBinding"><TableID>dbo_vDimTiempo</TableID><ColumnID>Anio</ColumnID></Source></KeyColumn><KeyColumn><DataType>UnsignedTinyInt</DataType><Source xsi:type="ColumnBinding"><TableID>dbo_vDimTiempo</TableID><ColumnID>Trimestre</ColumnID></Source></KeyColumn></KeyColumns><NameColumn><DataType>WChar</DataType><DataSize>20</DataSize><Source xsi:type="ColumnBinding"><TableID>dbo_vDimTiempo</TableID><ColumnID>TrimestreNombre</ColumnID></Source></NameColumn><AttributeRelationships><AttributeRelationship><AttributeID>Semestre</AttributeID><Name>Semestre</Name></AttributeRelationship></AttributeRelationships><OrderBy>Key</OrderBy></Attribute><Attribute><ID>Semestre</ID><Name>Semestre</Name><KeyColumns><KeyColumn><DataType>SmallInt</DataType><Source xsi:type="ColumnBinding"><TableID>dbo_vDimTiempo</TableID><ColumnID>Anio</ColumnID></Source></KeyColumn><KeyColumn><DataType>UnsignedTinyInt</DataType><Source xsi:type="ColumnBinding"><TableID>dbo_vDimTiempo</TableID><ColumnID>Semestre</ColumnID></Source></KeyColumn></KeyColumns><NameColumn><DataType>WChar</DataType><DataSize>20</DataSize><Source xsi:type="ColumnBinding"><TableID>dbo_vDimTiempo</TableID><ColumnID>SemestreNombre</ColumnID></Source></NameColumn><AttributeRelationships><AttributeRelationship><AttributeID>Anio</AttributeID><Name>Anio</Name></AttributeRelationship></AttributeRelationships><OrderBy>Key</OrderBy></Attribute><Attribute><ID>Anio</ID><Name>Año</Name><KeyColumns><KeyColumn><DataType>SmallInt</DataType><Source xsi:type="ColumnBinding"><TableID>dbo_vDimTiempo</TableID><ColumnID>Anio</ColumnID></Source></KeyColumn></KeyColumns><NameColumn><DataType>WChar</DataType><DataSize>20</DataSize><Source xsi:type="ColumnBinding"><TableID>dbo_vDimTiempo</TableID><ColumnID>AnioNombre</ColumnID></Source></NameColumn><OrderBy>Key</OrderBy></Attribute><Attribute><ID>Dia Semana</ID><Name>Día Semana</Name><KeyColumns><KeyColumn><DataType>UnsignedTinyInt</DataType><Source xsi:type="ColumnBinding"><TableID>dbo_vDimTiempo</TableID><ColumnID>DiaSemana</ColumnID></Source></KeyColumn></KeyColumns><NameColumn><DataType>WChar</DataType><DataSize>15</DataSize><Source xsi:type="ColumnBinding"><TableID>dbo_vDimTiempo</TableID><ColumnID>NombreDiaSemana</ColumnID></Source></NameColumn><OrderBy>Key</OrderBy></Attribute></Attributes>
