      <Cubes>
        <Cube>
          <ID>KentFoods</ID>
          <Name>KentFoods</Name>
          <Dimensions><Dimension><ID>Fecha Orden</ID><Name>Fecha Orden</Name><DimensionID>Dim Tiempo</DimensionID></Dimension><Dimension><ID>Fecha Envio</ID><Name>Fecha Envío</Name><DimensionID>Dim Tiempo</DimensionID></Dimension><Dimension><ID>Cliente</ID><Name>Cliente</Name><DimensionID>Dim Cliente</DimensionID></Dimension><Dimension><ID>Producto</ID><Name>Producto</Name><DimensionID>Dim Producto</DimensionID></Dimension><Dimension><ID>Empleado</ID><Name>Empleado</Name><DimensionID>Dim Empleado</DimensionID></Dimension><Dimension><ID>Transportista</ID><Name>Transportista</Name><DimensionID>Dim Transportista</DimensionID></Dimension></Dimensions>
