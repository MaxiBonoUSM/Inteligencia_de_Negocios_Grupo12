  <Source>
    <DataSourceViewID>KentFoodsDW</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript>
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>2026-11-10T01:13:54.016667Z</CreatedTimestamp>
      <LastSchemaUpdate>2026-11-10T01:13:54.016667Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CALCULATE;

-- KPI 2: Ticket promedio = ventas netas / número de órdenes
CREATE MEMBER CURRENTCUBE.[Measures].[Ticket Promedio]
 AS IIF([Measures].[Órdenes] = 0, NULL, [Measures].[Monto Neto] / [Measures].[Órdenes]),
FORMAT_STRING = "#,##0.00", VISIBLE = 1, DISPLAY_FOLDER = 'KPI', ASSOCIATED_MEASURE_GROUP = 'Ventas';

-- KPI 3: % de descuento = monto descontado / monto bruto
CREATE MEMBER CURRENTCUBE.[Measures].[% Descuento]
 AS IIF([Measures].[Monto Bruto] = 0, NULL, [Measures].[Monto Descuento] / [Measures].[Monto Bruto]),
FORMAT_STRING = "Percent", VISIBLE = 1, DISPLAY_FOLDER = 'KPI', ASSOCIATED_MEASURE_GROUP = 'Ventas';

-- KPI 4: % de participación en las ventas totales (sobre todos los empleados)
CREATE MEMBER CURRENTCUBE.[Measures].[% Participación Ventas]
 AS IIF(([Measures].[Monto Neto], Root([Empleado])) = 0, NULL,
        [Measures].[Monto Neto] / ([Measures].[Monto Neto], Root([Empleado]))),
FORMAT_STRING = "Percent", VISIBLE = 1, DISPLAY_FOLDER = 'KPI', ASSOCIATED_MEASURE_GROUP = 'Ventas';

-- KPI 5: Tiempo promedio de despacho = días totales / órdenes enviadas
CREATE MEMBER CURRENTCUBE.[Measures].[Días Promedio Despacho]
 AS IIF([Measures].[Órdenes Enviadas] = 0, NULL,
        [Measures].[Días Despacho Total] / [Measures].[Órdenes Enviadas]),
FORMAT_STRING = "#,##0.00", VISIBLE = 1, DISPLAY_FOLDER = 'KPI', ASSOCIATED_MEASURE_GROUP = 'Despacho';

-- KPI 6: % de órdenes pendientes de envío
CREATE MEMBER CURRENTCUBE.[Measures].[% Órdenes Pendientes]
 AS IIF([Measures].[Órdenes] = 0, NULL, [Measures].[Órdenes Pendientes] / [Measures].[Órdenes]),
FORMAT_STRING = "Percent", VISIBLE = 1, DISPLAY_FOLDER = 'KPI', ASSOCIATED_MEASURE_GROUP = 'Despacho';

-- KPI 1: Ventas del mismo período del año anterior y crecimiento
CREATE MEMBER CURRENTCUBE.[Measures].[Ventas Año Anterior]
 AS IIF([Fecha Orden].[Calendario].CurrentMember.Level.Ordinal = 0, NULL,
        ([Measures].[Monto Neto],
         ParallelPeriod([Fecha Orden].[Calendario].[Año], 1, [Fecha Orden].[Calendario].CurrentMember))),
FORMAT_STRING = "#,##0.00", VISIBLE = 1, DISPLAY_FOLDER = 'KPI', ASSOCIATED_MEASURE_GROUP = 'Ventas';

CREATE MEMBER CURRENTCUBE.[Measures].[% Crecimiento Ventas]
 AS IIF(IsEmpty([Measures].[Ventas Año Anterior]) OR [Measures].[Ventas Año Anterior] = 0, NULL,
        [Measures].[Monto Neto] / [Measures].[Ventas Año Anterior] - 1),
FORMAT_STRING = "Percent", VISIBLE = 1, DISPLAY_FOLDER = 'KPI', ASSOCIATED_MEASURE_GROUP = 'Ventas';
</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi>
      <ID>KPI Ventas Netas</ID>
      <Name>Ventas Netas</Name>
      <Description>Ventas netas; meta: superar el mismo período del año anterior.</Description>
      <DisplayFolder>KPI</DisplayFolder>
      <AssociatedMeasureGroupID>Fact Ventas</AssociatedMeasureGroupID>
      <Value>[Measures].[Monto Neto]</Value>
      <Goal>[Measures].[Ventas Año Anterior]</Goal>
      <Status>IIF(IsEmpty([Measures].[Ventas Año Anterior]), NULL, IIF([Measures].[Monto Neto] &gt;= [Measures].[Ventas Año Anterior], 1, -1))</Status>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
    <Kpi>
      <ID>KPI Descuento</ID>
      <Name>Tasa de Descuento</Name>
      <Description>Porcentaje del monto bruto entregado como descuento; meta referencial: 7 % o menos.</Description>
      <DisplayFolder>KPI</DisplayFolder>
      <AssociatedMeasureGroupID>Fact Ventas</AssociatedMeasureGroupID>
      <Value>[Measures].[% Descuento]</Value>
      <Goal>0.07</Goal>
      <Status>IIF(IsEmpty([Measures].[% Descuento]), NULL, IIF([Measures].[% Descuento] &lt;= 0.07, 1, -1))</Status>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
    <Kpi>
      <ID>KPI Despacho</ID>
      <Name>Tiempo de Despacho</Name>
      <Description>Días promedio entre orden y envío; meta referencial: 7 días o menos (amarillo hasta 10).</Description>
      <DisplayFolder>KPI</DisplayFolder>
      <AssociatedMeasureGroupID>Fact Ordenes</AssociatedMeasureGroupID>
      <Value>[Measures].[Días Promedio Despacho]</Value>
      <Goal>7</Goal>
      <Status>IIF(IsEmpty([Measures].[Días Promedio Despacho]), NULL, IIF([Measures].[Días Promedio Despacho] &lt;= 7, 1, IIF([Measures].[Días Promedio Despacho] &lt;= 10, 0, -1)))</Status>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
    <Kpi>
      <ID>KPI Pendientes</ID>
      <Name>Tasa de Pendientes</Name>
      <Description>Órdenes sin fecha de envío sobre el total; meta referencial: 2 % o menos.</Description>
      <DisplayFolder>KPI</DisplayFolder>
      <AssociatedMeasureGroupID>Fact Ordenes</AssociatedMeasureGroupID>
      <Value>[Measures].[% Órdenes Pendientes]</Value>
      <Goal>0.02</Goal>
      <Status>IIF(IsEmpty([Measures].[% Órdenes Pendientes]), NULL, IIF([Measures].[% Órdenes Pendientes] &lt;= 0.02, 1, -1))</Status>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
  </Kpis>
